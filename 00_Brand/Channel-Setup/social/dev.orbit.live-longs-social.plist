<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Orbit: when a YouTube long becomes public, soft-share a YouTube link card
  to Threads + Facebook Page (AppleScript / logged-in Chrome).

  Shorts stay on Meta/Threads Shorts watchers. TikTok stays paused.

  Install:
    cp this file to ~/Library/LaunchAgents/dev.orbit.live-longs-social.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.orbit.live-longs-social.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.orbit.live-longs-social</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/.venv-social/bin/python</string>
    <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/social/live_longs_to_social.py</string>
    <string>--once</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/social</string>
  <key>StandardOutPath</key>
  <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/social/live_longs_launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/social/live_longs_launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
