<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Orbit: when a YouTube Short becomes live, mirror it to Instagram Reels +
  Facebook Page Reels (Graph API preferred; Meta Business Suite CDP fallback).

  Install:
    cp this file to ~/Library/LaunchAgents/dev.orbit.meta-live-shorts.plist
    launchctl load ~/Library/LaunchAgents/dev.orbit.meta-live-shorts.plist

  Unload:
    launchctl unload ~/Library/LaunchAgents/dev.orbit.meta-live-shorts.plist

  Runs every 5 minutes.

  Disabled after 2026-08-17: CDP retry loop stacked Meta Reels composer
  tabs (Leave Page? + Chrome Restore pages?) and froze the Mac. Re-enable
  only after Graph credentials work, or after confirming the ledger treats
  status "posted" as done:

    /usr/libexec/PlistBuddy -c 'Set :Disabled false' ~/Library/LaunchAgents/dev.orbit.meta-live-shorts.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.orbit.meta-live-shorts.plist
-->
<plist version="1.0">
<dict>
  <key>Disabled</key>
  <true/>
  <key>Label</key>
  <string>dev.orbit.meta-live-shorts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/ben/code/Orbit-YouTube/00_Brand/Channel-Setup/Meta/auto/live_shorts_to_meta.py</string>
    <string>--once</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/Users/ben/code/Orbit-YouTube/00_Brand/Channel-Setup/Meta/auto</string>
  <key>StandardOutPath</key>
  <string>/Users/ben/code/Orbit-YouTube/00_Brand/Channel-Setup/Meta/auto_launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ben/code/Orbit-YouTube/00_Brand/Channel-Setup/Meta/auto_launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
