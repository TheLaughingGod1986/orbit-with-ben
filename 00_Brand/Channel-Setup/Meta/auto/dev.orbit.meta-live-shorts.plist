<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Orbit: when a YouTube Short becomes live, mirror it to Instagram Reels +
  Facebook Page Reels (Graph API preferred; Meta Business Suite CDP fallback).

  Install:
    cp this file to ~/Library/LaunchAgents/dev.orbit.meta-live-shorts.plist
    launchctl load ~/Library/LaunchAgents/dev.orbit.meta-live-shorts.plist

  Unload:
    launchctl unload ~/Library/LaunchAgents/dev.orbit.meta-live-shorts.plist

  Runs every 5 minutes.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.orbit.meta-live-shorts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/.venv-social/bin/python</string>
    <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/Meta/auto/live_shorts_to_meta.py</string>
    <string>--once</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/Meta/auto</string>
  <key>StandardOutPath</key>
  <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/Meta/auto_launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/Meta/auto_launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
