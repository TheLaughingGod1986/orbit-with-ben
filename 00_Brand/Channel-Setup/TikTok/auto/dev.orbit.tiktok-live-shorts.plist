<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Orbit: when a YouTube Short becomes live (published_now / schedule_iso due),
  mirror it to TikTok Studio via Chrome CDP.

  Install:
    cp this file to ~/Library/LaunchAgents/dev.orbit.tiktok-live-shorts.plist
    launchctl load ~/Library/LaunchAgents/dev.orbit.tiktok-live-shorts.plist

  Unload:
    launchctl unload ~/Library/LaunchAgents/dev.orbit.tiktok-live-shorts.plist

  PAUSED 25 Aug 2026 — TikTok posting ban. Do not load until Ben lifts
  TIKTOK_UPLOAD_BLOCK.json. Disabled=true in this file.
-->
<plist version="1.0">
<dict>
  <key>Disabled</key>
  <true/>
  <key>Label</key>
  <string>dev.orbit.tiktok-live-shorts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/TikTok/auto/live_shorts_to_tiktok.py</string>
    <string>--once</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/TikTok/auto</string>
  <key>StandardOutPath</key>
  <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/TikTok/auto_launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/benjaminoats/YouTube/orbit-with-ben/00_Brand/Channel-Setup/TikTok/auto_launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>TIKTOK_UPLOADS_PAUSED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
