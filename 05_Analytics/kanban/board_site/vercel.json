{
  "redirects": [
    { "source": "/classic", "destination": "/", "permanent": false },
    { "source": "/classic/", "destination": "/", "permanent": false },
    { "source": "/classic.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/tracker", "destination": "/tracker.html" },
    { "source": "/tracker/", "destination": "/tracker.html" },
    { "source": "/ai", "destination": "/ai.html" },
    { "source": "/board", "destination": "/board.html" },
    { "source": "/board/", "destination": "/board.html" },
    { "source": "/ai/", "destination": "/ai.html" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }]},
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }]},
    { "source": "/tracker", "headers": [{ "key": "Cache-Control", "value": "no-cache" }]},
    { "source": "/tracker.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }]},
    { "source": "/board", "headers": [{ "key": "Cache-Control", "value": "no-cache" }]},
    { "source": "/board.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }]},
    { "source": "/ai", "headers": [{ "key": "Cache-Control", "value": "no-cache" }]},
    { "source": "/ai.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }]},
    { "source": "/tracker.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }]},
    { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }]},
    { "source": "/updater.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }]}
  ]
}
