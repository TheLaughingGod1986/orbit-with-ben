    "topic",
    "script",
    "sources",
    "vo",
    "shots",
    "picture",
    "edit",
    "thumbs",
    "upload"
  ],
  "pipeline": {
    "kind": "film_status",
    "path": "02_Video-Projects/*/status.json"
  },
  "uat_dir": {
    "env": "OWB_UAT_DIR",
    "icloud": "OWB UAT"
  }
