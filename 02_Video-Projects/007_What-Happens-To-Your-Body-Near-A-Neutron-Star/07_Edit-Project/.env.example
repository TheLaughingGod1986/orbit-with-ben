# AI Studio Veo UI (Orbit CG default — Google One Ultra)
# One-time login (no API key needed for routine CG):
#   python3 04_Audio/tools/orbit_aistudio_veo_ui.py --login
# Profile: ~/code/youtube/.playwright-aistudio-profile
# ORBIT_AISTUDIO_PROFILE=

# Primary CG: Gemini Omni Flash API (gemini-omni-flash-preview)
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Flow Playwright is backup only when this key/billing is dead.

# Optional model override
# ORBIT_AISTUDIO_VEO_MODEL=veo-3.1-fast-generate-preview
