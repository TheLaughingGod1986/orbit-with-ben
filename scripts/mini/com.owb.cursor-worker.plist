<?xml version="1.0" encoding="UTF-8"?>
<!--
  Wakes Cursor's CLI agent every 30 minutes (08:00-22:00) to do the next job in its queue while it covers as Chief
  (Grok Bot out of credit, 7 Oct 2026). Runs only while ~/_desk/state/cursor-covers-chief exists.
  Install once (copies the script to ~/_desk/bin so a git pull can't change it mid-run):
    mkdir -p ~/_desk/bin ~/_desk/state && cp scripts/mini/cursor_worker.sh ~/_desk/bin/ && touch ~/_desk/state/cursor-covers-chief
    cp scripts/mini/com.owb.cursor-worker.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.owb.cursor-worker.plist
  When Grok is back:  rm ~/_desk/state/cursor-covers-chief   (the job then skips every run)
  Pause for a while:  touch ~/_desk/state/cursor-worker.pause   (rm it to resume)
  Remove:             launchctl bootout gui/$(id -u)/com.owb.cursor-worker
  Log: ~/Library/Logs/cursor-worker.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.owb.cursor-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>$HOME/_desk/bin/cursor_worker.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/benjaminoats/Library/Logs/cursor-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/benjaminoats/Library/Logs/cursor-worker.log</string>
</dict>
</plist>
