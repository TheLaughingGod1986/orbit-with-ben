<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.owb.agent.macbook</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/_desk/worker/orbit-with-ben" &amp;&amp; python3 scripts/agent_timer.py tick --agent macbook >> "$HOME/Library/Logs/agent-timer-macbook.log" 2>&gt;&amp;1</string>
  </array>
  <key>StartInterval</key>
  <integer>840</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
