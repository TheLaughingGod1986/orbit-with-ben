<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Studio Kanban data (scripts/board_publish.py): every 5 min, a no-op unless main, HOS PIPELINE.json or the Mini
     heartbeat changed. jobs.py also runs it straight after every queue change.
     Install: cp scripts/mini/com.owb.board-publish.plist ~/Library/LaunchAgents/ && launchctl load -w ~/Library/LaunchAgents/com.owb.board-publish.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.owb.board-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>python3 "$HOME/YouTube/orbit-with-ben/scripts/board_publish.py" --quiet</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOS_REPO</key><string>/Users/benjaminoats/YouTube/History Of Science</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/benjaminoats/Library/Logs/board-publish.log</string>
  <key>StandardErrorPath</key><string>/Users/benjaminoats/Library/Logs/board-publish.log</string>
</dict>
</plist>
