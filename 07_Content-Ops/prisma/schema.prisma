generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) URL for migrations. If unset locally, set DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model LongFormVideo {
  id                 String      @id @default(cuid())
  title              String
  workingTitle       String?
  slug               String      @unique
  topic              String
  category           String?
  status             String      @default("idea")
  script             String?
  summary            String?
  youtubeUrl         String?
  youtubeVideoId     String?
  thumbnailPath      String?
  finalVideoPath     String?
  durationSeconds    Int?
  publicationDate    DateTime?
  primaryKeyword     String?
  secondaryKeywords  String? // JSON array string
  targetAudience     String?
  projectFolder      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  clips              ShortClip[]
  affiliatePlacements AffiliatePlacement[]
  affiliateClicks     AffiliateClick[]
  affiliateConversions AffiliateConversion[]
}

model ShortClip {
  id                    String         @id @default(cuid())
  longFormVideoId       String
  longFormVideo         LongFormVideo  @relation(fields: [longFormVideoId], references: [id], onDelete: Cascade)
  clipNumber            Int
  workingTitle          String
  hook                  String?
  hookCategory          String?
  transcript            String?
  sourceStartTime       String?
  sourceEndTime         String?
  targetDurationSeconds Int?
  visualDirection       String?
  onScreenText          String?
  endingLine            String?
  callToAction          String?
  whyItWorks            String?
  exportPath            String?
  thumbnailPath         String?
  fileChecksum          String?
  status                String         @default("proposed")
  qualityScore          Int?
  qualityBreakdown      String? // JSON
  sortOrder             Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  posts                 PlatformPost[]

  @@unique([longFormVideoId, clipNumber])
}

model PlatformPost {
  id                    String           @id @default(cuid())
  shortClipId           String
  shortClip             ShortClip        @relation(fields: [shortClipId], references: [id], onDelete: Cascade)
  platform              String
  title                 String?
  caption               String?
  hashtags              String? // JSON array
  callToAction          String?
  scheduledAt           DateTime?
  publishedAt           DateTime?
  platformPostId        String?
  platformUrl           String?
  uploadStatus          String           @default("draft")
  publishingMethod      String           @default("manual")
  notes                 String?
  pinnedComment         String?
  coverText             String?
  storyCaption          String?
  commentPrompt         String?
  repostReason          String?
  approvedForPublish    Boolean          @default(false)
  privacyStatus         String?
  madeForKids           Boolean?
  containsSyntheticMedia Boolean?
  mediaChecksum         String?
  mediaFilePath         String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  metrics               PerformanceMetric[]
  publishingJobs        PublishingJob[]

  @@index([platform, uploadStatus])
  @@index([scheduledAt])
}

model PerformanceMetric {
  id                       String       @id @default(cuid())
  platformPostId           String
  platformPost             PlatformPost @relation(fields: [platformPostId], references: [id], onDelete: Cascade)
  recordedAt               DateTime     @default(now())
  views                    Int?
  impressions              Int?
  likes                    Int?
  comments                 Int?
  shares                   Int?
  saves                    Int?
  averageWatchTime         Float?
  averagePercentageViewed  Float?
  completionRate           Float?
  profileVisits            Int?
  linkClicks               Int?
  subscribersGained        Int?
  followersGained          Int?
  engagementRate           Float?
  /// Growth System v2 — YouTube Studio fields (optional CSV import)
  clickThroughRate         Float?
  retention30s             Float?
  retentionDropAtSeconds   Float?
  retentionDropDepth       Float?
  returningViewers         Int?
  newViewers               Int?
  browsePercent            Float?
  suggestedPercent         Float?
  searchPercent            Float?
  endScreenCtr             Float?
  cardsCtr                 Float?
  averageSessionSeconds    Float?
  importSource             String?
  importBatchId            String?
  createdAt                DateTime     @default(now())

  @@index([platformPostId, recordedAt])
  @@index([importBatchId])
}

model ContentInsight {
  id                 String   @id @default(cuid())
  type               String
  topic              String?
  platform           String?
  finding            String
  evidence           String?
  confidence         Float?
  recommendedAction  String?
  sampleSize         Int?
  createdAt          DateTime @default(now())
}

model PlatformSettings {
  id                    String    @id @default(cuid())
  platform              String    @unique
  enabled               Boolean   @default(true)
  accountDisplayName    String?
  profileUrl            String?
  defaultHashtags       String? // JSON
  defaultCallToAction   String?
  publishingMethod      String    @default("manual")
  postingTimesJson      String?
  connectionStatus      String    @default("manual_only")
  tokenStatus           String    @default("not_configured")
  lastSuccessfulPublish DateTime?
  defaultVisibility     String    @default("public")
  analyticsImportNotes  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model ContentTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  platform  String?
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AnalyticsImport {
  id           String   @id @default(cuid())
  platform     String
  filename     String
  importedAt   DateTime @default(now())
  rowCount     Int
  successCount Int
  errorCount   Int
  errorsJson   String?
  notes        String?
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model PlatformConnection {
  id                          String          @id @default(cuid())
  platform                    String
  accountId                   String?
  accountName                 String?
  accountUsername             String?
  accountType                 String?
  profileUrl                  String?
  avatarUrl                   String?
  channelId                   String?
  pageId                      String?
  instagramBusinessAccountId  String?
  externalUserId              String?
  connectionStatus            String          @default("pending")
  grantedScopes               String? // JSON array
  capabilitiesJson            String?
  accessTokenEncrypted        String?
  refreshTokenEncrypted       String?
  accessTokenExpiresAt        DateTime?
  refreshTokenExpiresAt       DateTime?
  lastValidatedAt             DateTime?
  lastRefreshAt               DateTime?
  lastSuccessfulPublishAt     DateTime?
  lastConnectionError         String?
  metadataJson                String?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  disconnectedAt              DateTime?
  jobs                        PublishingJob[]

  @@index([platform, connectionStatus])
  @@unique([platform, externalUserId])
}

model PublishingJob {
  id                    String              @id @default(cuid())
  platformPostId        String
  platformPost          PlatformPost        @relation(fields: [platformPostId], references: [id], onDelete: Cascade)
  platformConnectionId  String?
  platformConnection    PlatformConnection? @relation(fields: [platformConnectionId], references: [id], onDelete: SetNull)
  status                String              @default("pending")
  scheduledAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  nextAttemptAt         DateTime?
  attemptCount          Int                 @default(0)
  maxAttempts           Int                 @default(5)
  lockedAt              DateTime?
  lockedBy              String?
  idempotencyKey        String              @unique
  lastErrorCode         String?
  lastErrorMessage      String?
  lastErrorRetryable    Boolean?
  externalUploadId      String?
  externalPostId        String?
  externalPostUrl       String?
  requestSummary        String?
  responseSummary       String?
  dryRun                Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  attempts              PublishingAttempt[]

  @@index([status, nextAttemptAt])
  @@index([scheduledAt])
  @@index([lockedAt])
}

model PublishingAttempt {
  id                 String        @id @default(cuid())
  publishingJobId    String
  publishingJob      PublishingJob @relation(fields: [publishingJobId], references: [id], onDelete: Cascade)
  attemptNumber      Int
  startedAt          DateTime      @default(now())
  completedAt        DateTime?
  status             String
  requestId          String?
  httpStatus         Int?
  externalErrorCode  String?
  errorCategory      String?
  errorMessage       String?
  retryable          Boolean       @default(false)
  responseSummary    String?
  createdAt          DateTime      @default(now())

  @@index([publishingJobId, attemptNumber])
}

model OAuthState {
  id                     String    @id @default(cuid())
  platform               String
  stateHash              String    @unique
  codeVerifierEncrypted  String?
  redirectPath           String?
  expiresAt              DateTime
  usedAt                 DateTime?
  createdAt              DateTime  @default(now())

  @@index([expiresAt])
}

model WorkerHeartbeat {
  id               String   @id @default(cuid())
  workerId         String   @unique
  lastHeartbeatAt  DateTime
  lastJobId        String?
  status           String   @default("online")
  metadataJson     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Affiliate Monetisation — programmes, products, placements, tracking, revenue
/// Status values: ACTIVE | INACTIVE | PENDING
model AffiliateProgram {
  id                     String                @id @default(cuid())
  name                   String
  slug                   String                @unique
  description            String?
  website                String?
  network                String?
  defaultCommissionType  String                @default("PERCENTAGE") // PERCENTAGE | FIXED
  defaultCommissionValue Float?
  cookieDurationDays     Int?
  status                 String                @default("ACTIVE")
  /// Env key for affiliate tag/ID (never store real IDs in seed)
  affiliateIdEnvKey      String?
  categoriesJson         String? // JSON string array of supported categories
  disclosureText         String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  products               AffiliateProduct[]
  conversions            AffiliateConversion[]
}

model AffiliateProduct {
  id                   String                   @id @default(cuid())
  affiliateProgramId   String
  affiliateProgram     AffiliateProgram         @relation(fields: [affiliateProgramId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String                   @unique
  description          String?
  destinationUrl       String
  affiliateUrl         String
  imageUrl             String?
  category             String
  subcategory          String?
  price                Float?
  currency             String                   @default("GBP")
  estimatedCommission  Float?
  commissionType       String? // PERCENTAGE | FIXED — falls back to programme default
  commissionValue      Float?
  active               Boolean                  @default(true)
  featured             Boolean                  @default(false)
  priority             Int                      @default(0)
  evergreen            Boolean                  @default(false)
  /// Episode types this product is unsuitable for (JSON string array)
  unsuitableForJson    String?
  notes                String?
  urlHealthStatus      String                   @default("UNKNOWN") // HEALTHY | REDIRECTED | BROKEN | UNKNOWN
  urlLastCheckedAt     DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  tags                 AffiliateProductTag[]
  placements           AffiliatePlacement[]
  clicks               AffiliateClick[]
  conversions          AffiliateConversion[]
  urlHealthChecks      AffiliateUrlHealthCheck[]

  @@index([affiliateProgramId, active])
  @@index([category])
  @@index([featured, priority])
}

model AffiliateTag {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  createdAt DateTime             @default(now())
  products  AffiliateProductTag[]
}

model AffiliateProductTag {
  productId String
  tagId     String
  product   AffiliateProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       AffiliateTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

/// Placement types: DESCRIPTION_PRIMARY | DESCRIPTION_SECONDARY | PINNED_COMMENT |
/// WEBSITE_ARTICLE | GEAR_PAGE | SHORT_DESCRIPTION
model AffiliatePlacement {
  id                    String           @id @default(cuid())
  videoId               String
  video                 LongFormVideo    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  affiliateProductId    String
  affiliateProduct      AffiliateProduct @relation(fields: [affiliateProductId], references: [id], onDelete: Cascade)
  placementType         String
  position              Int              @default(0)
  relevanceScore        Float?
  manuallyApproved      Boolean          @default(false)
  generatedAutomatically Boolean         @default(false)
  status                String           @default("PENDING") // PENDING | APPROVED | REJECTED | ACTIVE | REMOVED
  clicks                Int              @default(0)
  conversions           Int              @default(0)
  estimatedRevenue      Float            @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  clickEvents           AffiliateClick[]

  @@unique([videoId, affiliateProductId, placementType])
  @@index([videoId, status])
  @@index([affiliateProductId])
}

model AffiliateClick {
  id                 String              @id @default(cuid())
  affiliateProductId String
  affiliateProduct   AffiliateProduct    @relation(fields: [affiliateProductId], references: [id], onDelete: Cascade)
  videoId            String?
  video              LongFormVideo?      @relation(fields: [videoId], references: [id], onDelete: SetNull)
  placementId        String?
  placement          AffiliatePlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull)
  source             String?
  campaign           String?
  medium             String?
  content            String?
  destinationUrl     String
  userAgent          String?
  referrer           String?
  timestamp          DateTime            @default(now())

  @@index([affiliateProductId, timestamp])
  @@index([videoId, timestamp])
  @@index([placementId])
}

model AffiliateConversion {
  id                 String           @id @default(cuid())
  affiliateProgramId String
  affiliateProgram   AffiliateProgram @relation(fields: [affiliateProgramId], references: [id], onDelete: Cascade)
  affiliateProductId String?
  affiliateProduct   AffiliateProduct? @relation(fields: [affiliateProductId], references: [id], onDelete: SetNull)
  videoId            String?
  video              LongFormVideo?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  orderReference     String?
  saleAmount         Float            @default(0)
  commissionAmount   Float            @default(0)
  currency           String           @default("GBP")
  conversionDate     DateTime
  imported           Boolean          @default(false)
  importBatchId      String?
  source             String? // amazon_csv | brilliant_csv | manual | other
  notes              String?
  createdAt          DateTime         @default(now())

  @@index([affiliateProgramId, conversionDate])
  @@index([affiliateProductId])
  @@index([videoId])
  @@index([importBatchId])
  @@unique([importBatchId, orderReference])
}

model AffiliateUrlHealthCheck {
  id                 String           @id @default(cuid())
  affiliateProductId String
  affiliateProduct   AffiliateProduct @relation(fields: [affiliateProductId], references: [id], onDelete: Cascade)
  status             String // HEALTHY | REDIRECTED | BROKEN | UNKNOWN
  httpStatus         Int?
  finalUrl           String?
  checkedAt          DateTime         @default(now())
  notes              String?

  @@index([affiliateProductId, checkedAt])
}

/// Editable YouTube / description snippet templates for affiliate blocks
model AffiliateDescriptionTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  category  String? // telescope | books | brilliant | lego | general | disclosure | amazon_disclosure | section_header
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffiliateImportBatch {
  id           String   @id @default(cuid())
  programmeSlug String?
  filename     String?
  source       String
  rowCount     Int
  successCount Int
  errorCount   Int
  skippedCount Int      @default(0)
  errorsJson   String?
  contentHash  String?  @unique
  importedAt   DateTime @default(now())
  notes        String?
}
