<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily Buffer check on the posting Mac (STUDIO_PLAYBOOK.md §12): at 07:05 local time,
  launchd/buffer-check.sh pulls main (only on main with no local code changes), moves or
  deletes Buffer posts when a YouTube time changed or a video no longer goes public,
  mirrors any new upload not in Buffer yet, pushes the Buffer record to main, and shows a
  notification if the check failed.
  Log: ~/Library/Logs/orbit-buffer-check.log
  Install (or reinstall after a change to this file):
    launchctl bootout gui/$(id -u)/dev.orbit.buffer-check 2>/dev/null
    cp 07_Content-Ops/launchd/dev.orbit.buffer-check.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.orbit.buffer-check.plist
  The repo path below assumes /Users/benjaminoats/YouTube/orbit-with-ben. Edit it if the repo lives elsewhere.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.orbit.buffer-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>/Users/benjaminoats/YouTube/orbit-with-ben/07_Content-Ops/launchd/buffer-check.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/benjaminoats/Library/Logs/orbit-buffer-check.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/benjaminoats/Library/Logs/orbit-buffer-check.log</string>
</dict>
</plist>
