<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily channel tracker on the posting Mac: at 06:40 local time, launchd/analytics-snapshot.sh
  snapshots every Orbit With Ben and History of Science video (read only, no spend), rebuilds
  05_Analytics/ (REPORT.md per channel and the dashboard) in its own worktree, and pushes it to
  main. Shows a notification if a channel failed.
  Log: ~/Library/Logs/orbit-analytics.log
  Install (or reinstall after a change to this file):
    launchctl bootout gui/$(id -u)/dev.orbit.analytics-snapshot 2>/dev/null
    cp 07_Content-Ops/launchd/dev.orbit.analytics-snapshot.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.orbit.analytics-snapshot.plist
  The repo path below assumes /Users/benjaminoats/YouTube/orbit-with-ben. Edit it if the repo lives elsewhere.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.orbit.analytics-snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>/Users/benjaminoats/YouTube/orbit-with-ben/07_Content-Ops/launchd/analytics-snapshot.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/benjaminoats/Library/Logs/orbit-analytics.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/benjaminoats/Library/Logs/orbit-analytics.log</string>
</dict>
</plist>
