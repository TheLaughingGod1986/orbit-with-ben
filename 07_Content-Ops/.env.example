# 07_Content-Ops/.env for the local scripts (STUDIO_PLAYBOOK.md §9, §12).
# Never commit .env or print its values. No database is needed.

# Google Cloud OAuth client (YouTube Data API). Add this authorised redirect URI on the client:
#   http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Written by: npx tsx --env-file=.env scripts/youtube-auth.ts
YOUTUBE_REFRESH_TOKEN=

# Buffer social mirror
BUFFER_API_KEY=
# Cloudflare R2 media host (bucket owb-media, public r2.dev URL). Required to host media: there is no
# Vercel Blob fallback any more (removed 29 Oct 2026).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# PUBLISHING_DRY_RUN=true

# Affiliate (the /go/ redirect app is retired; see STUDIO_PLAYBOOK.md §11)
# AMAZON_ASSOCIATE_TAG=
