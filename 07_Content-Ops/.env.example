# Hosted Postgres (Neon / Supabase / Vercel Postgres / local). Not SQLite.
# Pooled URL for the app (Prisma Client). On Neon, use the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/content_ops?sslmode=require"
# Direct (non-pooled) URL for prisma migrate. If your host has no pooler, set DIRECT_URL to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/content_ops?sslmode=require"

# Public origin of this Content Ops deploy (Vercel *.vercel.app or a custom domain you control).
# Production host for this app: https://orbit-content-ops.vercel.app
# Do not assume orbitwithben.com or oppti.dev — those hosts are not this app.
APP_BASE_URL=https://orbit-content-ops.vercel.app

# Operator password for mutating actions (add films, imports, apply URLs, settings, OAuth).
# Reads stay public. Required on Vercel Production + Preview — never commit the real value.
# After merge: set CONTENT_OPS_OPERATOR_PASSWORD on Vercel Production + Preview, then sign in at /login.
# Generate something long: openssl rand -base64 24
CONTENT_OPS_OPERATOR_PASSWORD=

# AES-256-GCM key (32 bytes, base64). Generate: openssl rand -base64 32
ORBIT_TOKEN_ENCRYPTION_KEY=

# Publishing
PUBLISHING_DRY_RUN=true
PUBLISHING_WORKER_ID=orbit-local-worker
MEDIA_STAGING_MODE=local_direct_upload
# MEDIA_PUBLIC_BASE_URL=https://your-bucket.example.com/orbit-staging

# Google / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:3000/api/oauth/google/callback
# Production: https://orbit-content-ops.vercel.app/api/oauth/google/callback
# If unset (or still localhost on Vercel), the app derives the callback from APP_BASE_URL / request host.
GOOGLE_REDIRECT_URI=

# Meta (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Threads (optional — only if product approved)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=

# Optional integration tests (never on by default)
RUN_YOUTUBE_INTEGRATION_TESTS=false
RUN_META_INTEGRATION_TESTS=false
RUN_TIKTOK_INTEGRATION_TESTS=false
RUN_X_INTEGRATION_TESTS=false

# Affiliate Monetisation (never commit real IDs)
# Amazon Associates UK tag — applied at /go redirect time only.
# Set on the Vercel project env (Production + Preview) only — NEVER commit the value.
AMAZON_ASSOCIATE_TAG=
# Brilliant referral / affiliate ID
BRILLIANT_AFFILIATE_ID=
# Optional override for tracked /go links. Defaults to ${APP_BASE_URL}/go when unset.
AFFILIATE_REDIRECT_BASE_URL=
