{
  "name": "content-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "worker": "tsx src/workers/publishing-worker.ts",
    "dev:all": "concurrently -k -n web,worker -c orange,cyan \"npm run dev\" \"npm run worker\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "connections:validate": "tsx scripts/validate-connections.ts",
    "publishing:reconcile": "tsx scripts/reconcile-publishing-jobs.ts",
    "publishing:cleanup": "tsx scripts/cleanup-staged-media.ts",
    "youtube:upload": "tsx scripts/youtube-api-upload.ts",
    "youtube:package": "tsx scripts/youtube-package-upload.ts",
    "youtube:verify-oauth": "tsx scripts/youtube-verify-oauth.ts",
    "youtube:shelf-verify": "tsx scripts/youtube-shelf-verify.ts",
    "youtube:recovery-status": "tsx scripts/youtube-recovery-status.ts",
    "youtube:forensic-inventory": "tsx scripts/youtube-full-catalogue-forensic.ts",
    "youtube:emergency-repair": "tsx scripts/youtube-emergency-repair.ts",
    "youtube:schedule-repair": "tsx scripts/youtube-schedule-repair.ts",
    "youtube:apply-approved-schedule": "tsx scripts/youtube-apply-approved-schedule.ts",
    "youtube:final-schedule-closure": "tsx scripts/youtube-final-schedule-closure.ts",
    "youtube:reconcile-16-to-13": "tsx scripts/youtube-reconcile-16-to-13.ts",
    "youtube:growth-optimise": "tsx scripts/youtube-growth-optimise.ts",
    "youtube:full-health-snapshot": "tsx scripts/youtube-full-health-snapshot.ts",
    "youtube:draft-orphan-audit": "tsx scripts/youtube-draft-orphan-cleanup-audit.ts",
    "youtube:execute-safe-repairs": "tsx scripts/youtube-execute-safe-repairs.ts",
    "generate:short-plan": "tsx scripts/generate-short-plan.ts",
    "generate:platform-copy": "tsx scripts/generate-platform-copy.ts",
    "create:export-package": "tsx scripts/create-export-package.ts",
    "import:performance": "tsx scripts/import-performance-data.ts",
    "review:script": "tsx scripts/review-script.ts",
    "diagnose:youtube": "tsx scripts/diagnose-youtube-growth.ts",
    "gate:episode": "tsx scripts/gate-episode.ts",
    "brief:next": "tsx scripts/next-episode-brief.ts",
    "verify:growth-v2": "vitest run tests/growth-system-v2.test.ts tests/episode-ops-v2.test.ts && tsx scripts/diagnose-youtube-growth.ts --file content/samples/json/youtube_growth_metrics_sample.json && tsx scripts/next-episode-brief.ts --file content/samples/json/youtube_growth_metrics_sample.json --out ../docs/NEXT_EPISODE_BRIEF.md"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "next": "^15.5.9",
    "papaparse": "^5.5.4",
    "prisma": "^6.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
